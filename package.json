{
  "name": "com.rommstream",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "dev:web": "vite --config vite.config.mts",
    "dev:desktop": "node scripts/run-desktop.mjs",
    "build:web": "vite build --config vite.config.mts",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "npm run build:web && npm run build:electron",
    "start:desktop": "npm run build:desktop && node scripts/run-desktop.mjs --built",
    "dist:desktop": "npm run build:desktop && electron-builder --publish never",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p e2e-desktop/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:build": "detox build --configuration android.emu.debug",
    "e2e:test": "detox test --configuration android.emu.debug",
    "e2e:desktop": "playwright test -c e2e-desktop/playwright.config.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.83.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.0-0",
    "react-native-keychain": "^10.0.0",
    "react-native-logs": "^5.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-webview": "^14.0.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@playwright/test": "^1.63.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "detox": "^20.51.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^29.7.0",
    "lefthook": "^2.1.14",
    "prettier": "2.8.8",
    "test-renderer": "^1.2.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "codegenConfig": {
    "name": "RommStreamAppSpec",
    "type": "modules",
    "jsSrcsDir": "src/native"
  }
}
