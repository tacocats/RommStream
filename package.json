    "@types/react": "^19.2.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "lefthook": "^2.1.14",
    "prettier": "2.8.8",
    "test-renderer": "^1.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.13"
